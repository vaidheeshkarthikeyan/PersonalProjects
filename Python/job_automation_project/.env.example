# ============================================================
# LinkedIn Job Automation Pipeline — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ============================================================

# --- LinkedIn Credentials (REQUIRED) ---
LI_EMAIL=your_linkedin_email@example.com
LI_PASSWORD=your_linkedin_password
LI_PHONE=+1234567890

# --- Search Configuration ---
# Comma-separated list of job titles to target
SEARCH_KEYWORDS=AI Engineer,Machine Learning Engineer
# LinkedIn filter: date posted (e.g., r86400 = past 24h, r604800 = past week)
DATE_POSTED=r604800
# LinkedIn filter: experience level (2=Entry, 3=Associate, 4=Mid-Senior)
EXPERIENCE_LEVEL=2,3,4

# --- Database ---
# SQLite (local dev — default if not set):
DATABASE_URL=sqlite:///job_automation.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/job_automation

# --- Flask ---
FLASK_SECRET_KEY=change-me-to-a-random-secret-key
FLASK_DEBUG=true

# --- Playwright ---
# Set to "false" to see the browser in action (useful for debugging)
HEADLESS=true

# --- OpenAI (OPTIONAL — fallback for question solver) ---
# Leave blank to use rule-based solver only; unrecognized questions will log "N/A"
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Email Alerts (OPTIONAL) ---
# SMTP configuration for bot completion/failure notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_EMAIL_TO=your_email@gmail.com
